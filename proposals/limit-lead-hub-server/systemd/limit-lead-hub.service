[Unit]
Description=Limit Lead Hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/RTS-AGE/proposals/limit-lead-hub-server
EnvironmentFile=/home/ubuntu/RTS-AGE/proposals/limit-lead-hub-server/.env
ExecStart=/home/ubuntu/RTS-AGE/.venv/bin/uvicorn kit_app:app --host 127.0.0.1 --port 8090
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/RTS-AGE/proposals/limit-lead-hub-server/data

[Install]
WantedBy=multi-user.target
